# ============================================
# Violence Surveillance System
# Environment Configuration Example
# ============================================
# 
# INSTRUCTIONS:
# 1. Copiez ce fichier en .env
# 2. Remplacez les valeurs d'exemple par vos configurations
# 3. Ne commitez JAMAIS le fichier .env (contient des secrets)
# 
# cp .env.example .env
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL Database (Production)
POSTGRES_USER=surveillance
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=surveillance
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database URL (PostgreSQL)
DATABASE_URL=postgresql://surveillance:CHANGE_ME_STRONG_PASSWORD_HERE@db:5432/surveillance

# Alternative: SQLite for development/testing (uncomment to use)
# DATABASE_URL=sqlite:///./data/surveillance.db

# ============================================
# BACKEND API CONFIGURATION
# ============================================

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE="Violence Surveillance API"
API_VERSION=1.0.0

# Environment (development, staging, production)
ENVIRONMENT=production
DEBUG=false

# Security
SECRET_KEY=your-secret-key-change-in-production-minimum-32-chars
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================
# AI MODELS CONFIGURATION
# ============================================

# Model Paths (relative to backend/ directory)
YOLO_MODEL_PATH=/app/models/project_yolo26x-pose.pt
TRANSFORMER_MODEL_PATH=/app/models/violence_transformer.pt
SCALER_PATH=/app/models/scaler.pkl

# Model Device (auto, cuda, cpu)
# auto = automatically select GPU if available, else CPU
DEVICE=auto

# ============================================
# VIOLENCE DETECTION SETTINGS
# ============================================

# Detection Threshold (0.0 - 1.0)
# Higher = fewer false positives, but may miss some incidents
# Lower = more sensitive, but more false positives
VIOLENCE_THRESHOLD=0.7

# Temporal Window Settings
SEQUENCE_LENGTH=30          # Number of frames to analyze (30 frames ≈ 1 second at 30fps)
WINDOW_STRIDE=10            # How often to run detection (every N frames)
FEATURE_DIM=20              # Dimension of pose features (do not change unless retrained)

# Pose Detection
MAX_PERSONS_PER_FRAME=10    # Maximum number of persons to track per frame
MIN_KEYPOINT_CONFIDENCE=0.5 # Minimum confidence for keypoint detection

# ============================================
# VIDEO RECORDING SETTINGS
# ============================================

# Recording Directory
RECORDINGS_DIR=/app/recordings

# Recording Duration
PRE_ALERT_SECONDS=5         # Seconds to record BEFORE alert
POST_ALERT_SECONDS=10       # Seconds to record AFTER alert

# Video Settings
RECORDING_FPS=30            # Frames per second for recordings
RECORDING_CODEC=mp4v        # Video codec (mp4v, h264, xvid)
THUMBNAIL_SIZE=320x240      # Thumbnail size (WIDTHxHEIGHT)

# Storage
MAX_RECORDINGS_SIZE_GB=100  # Maximum total size of recordings in GB
AUTO_CLEANUP_ENABLED=true   # Automatically delete old recordings
RECORDING_RETENTION_DAYS=30 # Keep recordings for N days

# ============================================
# CAMERA SETTINGS
# ============================================

# Default Camera Settings
DEFAULT_CAMERA_FPS=30
DEFAULT_CAMERA_RESOLUTION=1280x720
CAMERA_RECONNECT_ATTEMPTS=5
CAMERA_RECONNECT_DELAY=3    # Seconds between reconnection attempts

# Streaming
WEBSOCKET_FPS=10            # FPS for WebSocket streaming to frontend
JPEG_QUALITY=80             # JPEG quality for streaming (0-100)

# ============================================
# FRONTEND CONFIGURATION
# ============================================

# API URLs (for Docker, use service names; for local dev, use localhost)
VITE_API_URL=http://localhost:8001
VITE_WS_URL=ws://localhost:8001

# Frontend Settings
VITE_APP_TITLE="Violence Surveillance System"
VITE_REFRESH_INTERVAL=5000  # Milliseconds

# ============================================
# LOGGING CONFIGURATION
# ============================================

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log Format
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Log Files
LOG_FILE=/app/logs/app.log
LOG_MAX_BYTES=10485760      # 10MB
LOG_BACKUP_COUNT=5

# ============================================
# PERFORMANCE & OPTIMIZATION
# ============================================

# Threading
MAX_WORKERS=4               # Number of worker threads for camera processing
QUEUE_MAX_SIZE=100          # Maximum size of frame queue

# Batch Processing
BATCH_SIZE=1                # Batch size for model inference (usually 1 for real-time)

# GPU Settings (if using CUDA)
CUDA_DEVICE_ID=0            # GPU device ID
CUDA_MEMORY_FRACTION=0.8    # Fraction of GPU memory to use

# ============================================
# ALERTS & NOTIFICATIONS
# ============================================

# Alert Settings
ALERT_COOLDOWN_SECONDS=10   # Minimum seconds between alerts from same camera
ALERT_MIN_CONFIDENCE=0.7    # Minimum confidence to trigger alert

# Email Notifications (optional)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_TO=security@yourcompany.com

# Webhook Notifications (optional)
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://your-webhook-url.com/alerts

# ============================================
# BACKUP & MAINTENANCE
# ============================================

# Database Backup
DB_BACKUP_ENABLED=true
DB_BACKUP_INTERVAL_HOURS=24
DB_BACKUP_DIR=/app/backups

# Automatic Maintenance
MAINTENANCE_ENABLED=true
MAINTENANCE_HOUR=3          # Run maintenance at 3 AM

# ============================================
# DEVELOPMENT & TESTING
# ============================================

# Development Mode
DEV_MODE=false
DEV_AUTO_RELOAD=false

# Testing
TEST_DATABASE_URL=sqlite:///./test.db
TEST_VIDEO_PATH=/app/test_videos/sample.mp4

# Mock Detection (for testing without GPU)
MOCK_DETECTION=false
MOCK_DETECTION_PROBABILITY=0.1

# ============================================
# MONITORING & METRICS
# ============================================

# Prometheus Metrics (optional)
METRICS_ENABLED=false
METRICS_PORT=9090

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=60    # Seconds

# ============================================
# DOCKER SPECIFIC
# ============================================

# Docker Compose Settings
COMPOSE_PROJECT_NAME=violence-surveillance

# Ports
BACKEND_PORT=8001
FRONTEND_PORT=3000
NGINX_PORT=8080
DB_PORT=5432

# Volumes
MODELS_VOLUME=./backend/models
RECORDINGS_VOLUME=./recordings
DB_VOLUME=pgdata

# ============================================
# NOTES
# ============================================
#
# SECURITY TIPS:
# - Use strong passwords (minimum 16 characters)
# - Change SECRET_KEY in production
# - Never commit .env file to version control
# - Use environment-specific .env files (.env.prod, .env.dev)
# - Rotate credentials regularly
#
# PERFORMANCE TIPS:
# - Use CUDA/GPU for better performance
# - Adjust VIOLENCE_THRESHOLD based on your needs
# - Lower WEBSOCKET_FPS if bandwidth is limited
# - Increase WINDOW_STRIDE for faster processing (less accurate)
#
# STORAGE TIPS:
# - Monitor recordings disk usage
# - Enable AUTO_CLEANUP to prevent disk full
# - Adjust RECORDING_RETENTION_DAYS based on requirements
# - Consider external storage for long-term archival
#
# ============================================
